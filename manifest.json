{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.4.0",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_TW",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "__MSG_commandTogglePanel__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/config.js",
        "src/core.js",
        "src/exporter.js",
        "src/shadow-style.js",
        "src/pack-core.js",
        "src/pack-capture.js",
        "src/pack-ui.js",
        "src/content.js"
      ],
      "css": [
        "styles/app.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
