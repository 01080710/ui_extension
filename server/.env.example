# Copy to .env (never commit .env). The server refuses to start if a required value is missing.

# Required. Stays on this machine: never sent to the extension or in any response.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5-5.
CLAUDE_MODEL=claude-sonnet-5-5

# Required, 24+ printable characters, no spaces. Paste the same value into the
# extension's component-pack card. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LOCAL_TOKEN=

# Required. Only requests from this origin are accepted. Find the id at chrome://extensions
# (Developer mode) and write it as chrome-extension://<id>. Firefox: moz-extension://<uuid>.
EXTENSION_ORIGIN=chrome-extension://
